# Copy to .env.production and replace every CHANGE_ME value. Never commit that file.
APP_NAME="Legal AI Intelligence Platform"
APP_ENV=production
ROOT_PATH=/api
LOG_LEVEL=INFO
SITE_ADDRESS=http://localhost
FRONTEND_ORIGIN=http://localhost

POSTGRES_DB=legal_ai
POSTGRES_USER=legal_ai
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DATABASE_PASSWORD
# Percent-encode URI-reserved password characters such as @ : / # and %.
DATABASE_URL=postgresql+psycopg://legal_ai:CHANGE_ME_URL_ENCODED_PASSWORD@postgres:5432/legal_ai
SECRET_KEY=CHANGE_ME_RANDOM_SECRET_AT_LEAST_32_BYTES

REDIS_TIMEOUT_SECONDS=2
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT=10
AI_RATE_LIMIT=20
DOCUMENT_WRITE_RATE_LIMIT=10
DOCUMENT_QUEUE_NAME=documents
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256
MAX_UPLOAD_SIZE_MB=20
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=16

LLM_PROVIDER=openai-compatible
LLM_MODEL=CHANGE_ME_MODEL
LLM_API_KEY=CHANGE_ME_PROVIDER_KEY
LLM_BASE_URL=CHANGE_ME_PROVIDER_API_ROOT
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=800
LLM_TIMEOUT_SECONDS=60
RAG_MIN_SIMILARITY=0.45
RAG_MAX_CONTEXT_CHARS=12000
CHAT_HISTORY_MAX_MESSAGES=6
