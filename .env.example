APP_NAME="Legal AI Intelligence Platform"
APP_ENV=development

# Public, disposable development values only. Never reuse in production.
POSTGRES_DB=legal_ai
POSTGRES_USER=legal_ai_dev
POSTGRES_PASSWORD=local_dev_only_change_me

# Local Python uses localhost. Compose overrides the host to postgres.
DATABASE_URL=postgresql+psycopg://legal_ai_dev:local_dev_only_change_me@localhost:5433/legal_ai

# Generate your own random key: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Intentionally blank: the application refuses to start without a strong key.
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALGORITHM=HS256

# Relative to the project root. Compose uses its persistent /app/storage volume.
DOCUMENT_STORAGE_PATH=storage/documents
MAX_UPLOAD_SIZE_MB=20

# Character counts, not tokens. Require 0 <= CHUNK_OVERLAP < CHUNK_SIZE.
CHUNK_SIZE=1200
CHUNK_OVERLAP=200

EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-small
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=16
HF_HOME=.cache/huggingface

# Leave model/key blank to disable generation without blocking app startup.
LLM_PROVIDER=openai-compatible
LLM_MODEL=
LLM_API_KEY=
# Optional API root including /v1, not /chat/completions.
LLM_BASE_URL=
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=800
LLM_TIMEOUT_SECONDS=60
RAG_MIN_SIMILARITY=0.45
RAG_MAX_CONTEXT_CHARS=12000

# Bounded recent messages used to rewrite follow-up questions.
CHAT_HISTORY_MAX_MESSAGES=6
