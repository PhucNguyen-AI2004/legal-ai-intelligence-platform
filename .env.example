APP_NAME="Legal AI Intelligence Platform"
APP_ENV=development

# Public, disposable development values only. Never reuse in production.
POSTGRES_DB=legal_ai
POSTGRES_USER=legal_ai_dev
POSTGRES_PASSWORD=local_dev_only_change_me

# Local Python uses localhost. Compose overrides the host to postgres.
DATABASE_URL=postgresql+psycopg://legal_ai_dev:local_dev_only_change_me@localhost:5432/legal_ai
